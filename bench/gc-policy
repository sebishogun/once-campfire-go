#!/usr/bin/env python3
"""Measure one binary under different CAMPFIRE_GOGC (and CAMPFIRE_GOMEMLIMIT) settings.

The binary is the same in every arm; only the GC target differs, so this is the ENGINE-47
question (does a higher GOGC buy throughput on reads without an unreasonable RSS cost) with
the wire bytes held fixed. Reads are room_show, messages_page, sidebar and search, driven at
concurrency 16 through the public front listener, gzip requested, on a disposable SQLite
backup of a reference seed, with the server pinned to four CPUs.

Arms are given as `GOGC` or `GOGC:LIMIT` (for example `200:256MiB`), optionally with `@NAME` to
label an arm (so `100@null` is a second, identically configured arm used to measure the host's
noise floor); the first arm is the baseline. Runs alternate between arms and the order rotates
each repetition, because the host is shared: the report gives medians and min–max, and pairs each
non-baseline arm against the baseline within the same repetition (a ratio, which cancels slow host
drift). GODEBUG=gctrace=1 is set for every arm so GC CPU and cycle counts come from the runtime
itself.

The decoded body of every route is fetched once per run, normalized only for the listener
origin and the room page's live cursor, and required to be byte-identical across every run:
the GC target must not move the wire bytes.
"""
import argparse, datetime, hashlib, json, os, platform, re, shutil, socket, sqlite3, statistics, subprocess, tempfile, threading, time, urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
READ_ROUTES = ('room_show', 'messages_page', 'sidebar', 'search')
CURSOR = re.compile(rb'(data-refresh-room-loaded-at-value=")[0-9]+')
GC_POLICY = re.compile(r'gc policy.*gc_percent=(-?\d+).*mem_limit=(-?\d+)')
GCTRACE = re.compile(r'^gc (\d+) @[\d.]+s (\d+)%: [\d.+]+ ms clock, ([\d./+]+) ms cpu,', re.M)


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def free_port():
    with socket.socket(socket.AF_INET6, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        sock.bind(('::', 0))
        return sock.getsockname()[1]


def output(*cmd, **kwargs):
    return subprocess.check_output(cmd, text=True, **kwargs).strip()


def default_seed():
    for candidate in (ROOT.parent / 'once-campfire-verification' / 'fixtures' / 'default',
                      ROOT.parent / 'once-campfire-rust' / 'parity' / '.seed' / 'default'):
        if (candidate / 'db' / 'production.sqlite3').is_file():
            return candidate
    raise SystemExit('no reference seed found; pass --seed')


def default_loadgen():
    for candidate in (ROOT.parent / 'once-campfire-verification' / 'loadgen' / 'target' / 'release' / 'loadgen',
                      ROOT.parent / 'once-campfire-rust' / 'target' / 'bench' / 'release' / 'loadgen'):
        if candidate.is_file():
            return candidate
    raise SystemExit('no load generator found; pass --loadgen')


def seed_env(seed):
    for candidate in (seed / 'reference.env', seed.parent / 'reference.env'):
        if candidate.is_file():
            return {k: v for k, v in (line.split('=', 1) for line in candidate.read_text().splitlines()
                                      if line and not line.startswith('#') and '=' in line)}
    raise SystemExit(f'no reference.env under {seed}')


def parse_arm(spec):
    core, _, alias = spec.partition('@')
    gc, _, limit = core.partition(':')
    label = alias or (gc + (f'+{limit}' if limit else ''))
    return dict(spec=spec, googc=int(gc), gomemlimit=limit or None, label=label)


def rss_kib(pid):
    try:
        for line in Path(f'/proc/{pid}/smaps_rollup').read_text().splitlines():
            if line.startswith('Rss:'):
                return int(line.split()[1])
    except (FileNotFoundError, ProcessLookupError):
        pass
    return None


def cpu_seconds(pid):
    fields = Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()
    return (int(fields[11]) + int(fields[12])) / os.sysconf('SC_CLK_TCK')


def parse_gctrace(log):
    """Total GC CPU (ms), GC cycles, and the last reported GC CPU share, from gctrace lines."""
    total_ms, cycles, share = 0.0, 0, None
    for match in GCTRACE.finditer(log):
        cycles = max(cycles, int(match.group(1)))
        share = int(match.group(2))
        total_ms += sum(float(part) for part in re.split(r'[+/]', match.group(3)))
    return total_ms, cycles, share


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--binary', type=Path, default=ROOT / 'campfire')
    parser.add_argument('--seed', type=Path, default=None)
    parser.add_argument('--loadgen', type=Path, default=None)
    parser.add_argument('--values', nargs='+', default=['100', '200'], metavar='GOGC[:LIMIT]')
    parser.add_argument('--reps', type=int, default=5)
    parser.add_argument('--seconds', type=float, default=4)
    parser.add_argument('--warmup', type=float, default=2)
    parser.add_argument('--concurrency', type=int, default=16)
    parser.add_argument('--server-cpus', default='8-11')
    parser.add_argument('--loadgen-cpus', default='12-15')
    parser.add_argument('--out', type=Path)
    args = parser.parse_args()
    if args.reps < 2 or len(args.values) < 2:
        parser.error('need at least two repetitions and two arms')
    arms = [parse_arm(spec) for spec in args.values]
    if len({arm['spec'] for arm in arms}) != len(arms):
        parser.error('arms must be unique')
    binary = args.binary.resolve()
    seed = (args.seed or default_seed()).resolve()
    loadgen = (args.loadgen or default_loadgen()).resolve()
    for path in (binary, loadgen, seed / 'db' / 'production.sqlite3'):
        if not path.is_file():
            parser.error(f'missing {path}')
    labels = json.loads((seed / 'labels.json').read_text())
    room = labels['rooms.watercooler']
    out = (args.out or ROOT / 'bench/results' / datetime.datetime.now(datetime.timezone.utc).strftime('gc-policy-%Y%m%dT%H%M%SZ')).resolve()
    out.mkdir(parents=True, exist_ok=False)
    env = {k: v for k, v in os.environ.items() if not k.startswith(('CAMPFIRE_', 'THRUSTER_')) and k != 'TLS_DOMAIN'}
    env.update(seed_env(seed))
    env.update(DISABLE_SSL='true', TARGET_BIND='127.0.0.1', GOMAXPROCS='4', TMPDIR=str(ROOT / '.cache/tmp'), GODEBUG='gctrace=1')
    paths = {'room_show': f'/rooms/{room}',
             'messages_page': f'/rooms/{room}/messages?before={labels["messages.busy_060"]}',
             'sidebar': '/users/me/sidebar', 'search': '/searches?q=coffee'}
    metadata = dict(scope='same binary, CAMPFIRE_GOGC/CAMPFIRE_GOMEMLIMIT only; public front listener; gzip; read routes at concurrency 16',
        time=datetime.datetime.now(datetime.timezone.utc).isoformat(), host=platform.platform(),
        cpu=output('lscpu'), go_commit=output('git', '-C', str(ROOT), 'rev-parse', 'HEAD'),
        go_dirty=bool(output('git', '-C', str(ROOT), 'status', '--porcelain', '--untracked-files=no')),
        go_version=output('go', 'version'), binary=dict(sha256=sha(binary), bytes=binary.stat().st_size),
        loadgen_sha256=sha(loadgen), seed=str(seed), seed_sha256=sha(seed / 'db' / 'production.sqlite3'),
        settings=vars(args) | {'binary': str(binary), 'seed': str(seed), 'loadgen': str(loadgen), 'out': str(out)},
        load_before=Path('/proc/loadavg').read_text().strip())
    (out / 'metadata.json').write_text(json.dumps(metadata, indent=2) + '\n')
    work = ROOT / 'bench/.work'; work.mkdir(exist_ok=True)
    results, body_hashes = [], {}
    for rep in range(1, args.reps + 1):
        # Cyclic rotation, not a reversal: with more than two arms a reversal leaves the middle
        # arm in the same slot every repetition, which would hide host drift from the noise floor.
        shift = (rep - 1) % len(arms)
        order = arms[shift:] + arms[:shift]
        for arm in order:
            with tempfile.TemporaryDirectory(prefix=f"gc{arm['label']}-{rep}-", dir=work) as tmp:
                tmp = Path(tmp)
                db = tmp / 'production.sqlite3'
                with sqlite3.connect(f'file:{seed}/db/production.sqlite3?mode=ro', uri=True) as source, sqlite3.connect(db) as dest:
                    source.backup(dest)
                shutil.copytree(seed / 'storage', tmp / 'storage' / 'files')
                port, front = free_port(), free_port()
                while front == port:
                    front = free_port()
                base = f'http://127.0.0.1:{front}'
                runenv = env | dict(CAMPFIRE_DATABASE_PATH=str(db), CAMPFIRE_STORAGE_PATH=str(tmp / 'storage'),
                                    CAMPFIRE_FILES_PATH=str(tmp / 'storage' / 'files'), CAMPFIRE_GOGC=str(arm['googc']),
                                    TARGET_PORT=str(port), HTTP_PORT=str(front))
                if arm['gomemlimit']:
                    runenv['CAMPFIRE_GOMEMLIMIT'] = arm['gomemlimit']
                row = dict(app='go', label=arm['label'], googc=arm['googc'], gomemlimit=arm['gomemlimit'],
                           rep=rep, routes=[], load_start=Path('/proc/loadavg').read_text().strip())
                log_path = tmp / 'server.log'
                with log_path.open('w') as log:
                    proc = subprocess.Popen(['taskset', '-c', args.server_cpus, str(binary), 'server'], cwd=ROOT, env=runenv, stdout=log, stderr=subprocess.STDOUT)
                    peak = [0]
                    sampling = threading.Event()

                    def sample():
                        while not sampling.is_set():
                            current = rss_kib(proc.pid)
                            if current:
                                peak[0] = max(peak[0], current)
                            sampling.wait(0.05)
                    sampler = threading.Thread(target=sample)
                    sampler.start()
                    try:
                        deadline = time.monotonic() + 30
                        while True:
                            if proc.poll() is not None:
                                raise RuntimeError(f'server exited: see {log_path.name}')
                            try:
                                with urllib.request.urlopen(base + '/up', timeout=1) as response:
                                    if response.status == 200:
                                        break
                            except OSError:
                                if time.monotonic() > deadline:
                                    raise RuntimeError('startup timed out')
                                time.sleep(0.02)
                        load = lambda *argv: json.loads(output('taskset', '-c', args.loadgen_cpus, str(loadgen), *argv, timeout=180))
                        cookie = load('login', '--base', base, '--email', labels['emails.david'], '--password', labels['passwords.all'])['cookie']
                        load('scrape', '--base', base, '--cookie', cookie, '--room', str(room))
                        for name in READ_ROUTES:
                            common = ['http', '--base', base, '--cookie', cookie, '--path', paths[name]]
                            load(*common, '--conc', '4', '--duration', str(args.warmup))
                            sample = load(*common, '--conc', str(args.concurrency), '--duration', str(args.seconds))
                            if sample['errors'] or set(sample['statuses']) != {'200'}:
                                raise RuntimeError(f'{name}: unsuccessful requests {sample}')
                            row['routes'].append(dict(route=name, rps=sample['rps'], p99_ms=sample['latency'].get('p99_ms'), ok=sample['ok'], bytes=sample['avg_bytes']))
                            print(f"{arm['label']} rep={rep} {name}: {sample['rps']:,.0f} req/s p99={sample['latency'].get('p99_ms')} ms", flush=True)
                            output('taskset', '-c', args.loadgen_cpus, str(loadgen), 'fetch', '--base', base, '--cookie', cookie, '--path', paths[name], '--out', str(tmp / f'{name}.body'), timeout=180)
                            decoded = (tmp / f'{name}.body').read_bytes().replace(base.encode(), b'http://benchmark.invalid')
                            body_sha = hashlib.sha256(CURSOR.sub(rb'\g<1>CURSOR', decoded)).hexdigest()
                            if name in body_hashes and body_hashes[name] != body_sha:
                                raise RuntimeError(f'{name}: decoded body differs between GC settings')
                            body_hashes[name] = body_sha
                            row.setdefault('body_sha256', {})[name] = body_sha
                        row['rss_peak_kib'] = peak[0]
                        row['rss_final_kib'] = rss_kib(proc.pid)
                        row['cpu_seconds'] = round(cpu_seconds(proc.pid), 3)
                        row['requests'] = sum(route['ok'] for route in row['routes'])
                        row['load_end'] = Path('/proc/loadavg').read_text().strip()
                    finally:
                        sampling.set(); sampler.join()
                        proc.terminate()
                        try:
                            proc.wait(timeout=15)
                        except subprocess.TimeoutExpired:
                            proc.kill(); proc.wait()
                # The per-request access log (LOG_REQUESTS, on by default and left on here for
                # harness fidelity) is hundreds of megabytes per run; keep the startup and GC
                # lines and the warnings, and only count the rest.
                kept, lines = [], 0
                with log_path.open() as logfile:
                    for line in logfile:
                        lines += 1
                        if line.startswith('gc ') or 'gc policy' in line or 'level=WARN' in line or 'level=ERROR' in line:
                            kept.append(line)
                logtext = ''.join(kept)
                (out / f"go{arm['label']}-{rep}.log").write_text(logtext)
                row['server_log_bytes'], row['server_log_lines'] = log_path.stat().st_size, lines
                row['gc_cpu_ms'], row['gc_cycles'], row['gc_share_percent'] = parse_gctrace(logtext)
                effective = GC_POLICY.search(logtext)
                row['effective_gc_percent'] = int(effective.group(1)) if effective else None
                row['effective_mem_limit'] = int(effective.group(2)) if effective else None
                row['gc_cpu_per_request_us'] = round(1000.0 * row['gc_cpu_ms'] / max(1, row['requests']), 3)
                row['cpu_us_per_request'] = round(1e6 * row['cpu_seconds'] / max(1, row['requests']), 3)
                row['log'] = f"go{arm['label']}-{rep}.log"
                results.append(row)
                (out / 'raw.json').write_text(json.dumps(results, indent=2) + '\n')

    def group(label, name):
        return [route for row in results if row['label'] == label for route in row['routes'] if route['route'] == name]

    baseline = arms[0]['label']
    legend = ', '.join(f"`{arm['label']}` (GOGC={arm['googc']}" + (f", limit={arm['gomemlimit']}" if arm['gomemlimit'] else '') + ')' for arm in arms)
    report = ['# GOGC arms: one binary, read workload', '',
        f"`{metadata['go_commit']}` (`{metadata['binary']['sha256'][:12]}`), Go 1.27.1, {platform.node()}. Public front listener, gzip, "
        f"{args.concurrency} concurrent clients on {args.loadgen_cpus}, server pinned to {args.server_cpus}, "
        f"{args.warmup:g}s warmup and {args.seconds:g}s samples per route, {args.reps} repetitions per arm, order "
        f"rotating cyclically each repetition so every arm occupies every slot. "
        f"Decoded bodies are byte-identical across every run (normalized only for the listener origin and the room page's live cursor). "
        f"GODEBUG=gctrace=1 in every arm; host load at start: {metadata['load_before']}.", '',
        f'Arms: {legend}. An arm with the same GOGC as the baseline and a different label is the host noise floor.', '',
        '| Route | Arm | req/s, median [min–max] | CPU µs/req | GC CPU µs/req | GC cycles | GC share % | RSS peak MiB, median [min–max] |',
        '|---|---:|---:|---:|---:|---:|---:|---:|']
    for name in READ_ROUTES:
        for arm in arms:
            rates = [route['rps'] for route in group(arm['label'], name)]
            p99 = [route['p99_ms'] for route in group(arm['label'], name)]
            rows = [row for row in results if row['label'] == arm['label']]
            rss = [row['rss_peak_kib'] / 1024 for row in rows]
            report.append(f"| {name} | {arm['label']} | {statistics.median(rates):,.0f} [{min(rates):,.0f}–{max(rates):,.0f}] | "
                          f"{statistics.median(row['cpu_us_per_request'] for row in rows):.2f} | "
                          f"{statistics.median(row['gc_cpu_per_request_us'] for row in rows):.3f} | "
                          f"{statistics.median(row['gc_cycles'] for row in rows):.0f} | "
                          f"{statistics.median(row['gc_share_percent'] for row in rows)} | "
                          f"{statistics.median(rss):.1f} [{min(rss):.1f}–{max(rss):.1f}] |")
    report += ['', '## Paired ratios against the baseline (same repetition)', '',
        f'Ratios to the `{baseline}` arm measured in the same repetition, and the number of repetitions that '
        'favour the arm. Throughput ratio above 1 (or CPU µs/req ratio below 1) with every repetition agreeing '
        'is a clear sign; mixed signs mean the host noise is larger than the effect.', '',
        '| Route | Arm | req/s ratio, median [min–max] | reps >1 | CPU µs/req ratio, median [min–max] | reps <1 |',
        '|---|---:|---:|---:|---:|---:|']
    for name in READ_ROUTES:
        for arm in arms[1:]:
            rate_ratios, cpu_ratios = [], []
            for rep in range(1, args.reps + 1):
                def pick(label, field):
                    for row in results:
                        if row['label'] != label or row['rep'] != rep:
                            continue
                        if field == 'cpu':
                            return row['cpu_us_per_request']
                        for route in row['routes']:
                            if route['route'] == name:
                                return route['rps']
                    return None
                base_rate, other_rate = pick(baseline, 'rps'), pick(arm['label'], 'rps')
                base_cpu, other_cpu = pick(baseline, 'cpu'), pick(arm['label'], 'cpu')
                if base_rate and other_rate:
                    rate_ratios.append(other_rate / base_rate)
                if base_cpu and other_cpu:
                    cpu_ratios.append(other_cpu / base_cpu)
            report.append(f"| {name} | {arm['label']} | {statistics.median(rate_ratios):.3f} [{min(rate_ratios):.3f}–{max(rate_ratios):.3f}] | "
                          f"{sum(1 for ratio in rate_ratios if ratio > 1)}/{len(rate_ratios)} | "
                          f"{statistics.median(cpu_ratios):.3f} [{min(cpu_ratios):.3f}–{max(cpu_ratios):.3f}] | "
                          f"{sum(1 for ratio in cpu_ratios if ratio < 1)}/{len(cpu_ratios)} |")
    report += ['', 'Per-repetition samples, the GC and startup lines of each server log (with the effective '
               '`gc policy` line), decoded body hashes, binary hash, seed hash and host load are in `raw.json`, '
               '`metadata.json` and `go*.log`; the per-request access log is left on (harness fidelity) and only '
               'its line and byte counts are kept. This is a workstation measurement on a shared host; medians, '
               'spread and paired signs are the evidence, not single samples.', '']
    (out / 'report.md').write_text('\n'.join(report) + '\n')
    print('\n'.join(report))


if __name__ == '__main__':
    main()
